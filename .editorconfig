root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt uses tabs; anything else fights `go fmt` on every save.
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# Trailing whitespace is a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
